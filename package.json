{
  "name": "dsh-workspace-preview",
  "description": "dsh-workspace-preview: dsh 工作台插件 —— 4 列布局的工作区文件浏览器（第 3 列文件预览：代码高亮 / Markdown 渲染（内嵌图片直连媒体路由）/ 沙箱 HTML 路由 / 图片，第 4 列可隐藏的目录树边栏，v0.3 起含文件名搜索、软链接展示、viewer 注册表 + 懒 chunk、mtimeMs 冲突安全原子写）。零依赖。",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "agent",
    "plugin",
    "cordis",
    "file-explorer",
    "workspace",
    "preview",
    "markdown",
    "file-tree",
    "search",
    "office"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  }
}
